# Workflow display name — shown in the repo's "Actions" tab.
name: Execute Separate Python Script

# Trigger: what starts this workflow.
# workflow_dispatch = manual only. Run it from Actions → Hello World → "Run workflow",
# or from the CLI: gh workflow run "Hello World"
# Other common triggers: push, pull_request, schedule (cron).
on:
  workflow_dispatch:

# A workflow contains one or more jobs. Jobs run in parallel by default;
# use `needs: <job-id>` to make one job wait for another.
jobs:
  # Job ID — any name you choose; referenced by `needs:` in other jobs.
  execute-separate-python-script:
    # Runner: the machine the job runs on. GitHub creates a fresh VM per run
    # and throws it away afterward. Alternatives: windows-latest, macos-latest.
    runs-on: ubuntu-latest

    steps:
      # `name` is the label shown in the run logs.
      # `run` executes a shell command (bash on Ubuntu).
      # Use `run: |` for multiple commands, or `uses:` to call a prebuilt action
      # (e.g. `uses: actions/checkout@v4` to fetch the repo's code).
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: 3.12

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Execute separate Python script
        run: python scripts/hello.py
